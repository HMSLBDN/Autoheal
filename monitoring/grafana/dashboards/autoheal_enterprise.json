  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Operational Availability",
      "type": "stat",
      "targets": [
        {
          "expr": "autoheal_up",
          "legendFormat": "Status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OPERATIONAL", "color": "green" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "HTTP 5xx Error Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(autoheal_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(autoheal_http_requests_total[5m]))) * 100",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Database Connection Pool Saturation",
      "type": "gauge",
      "targets": [
        {
          "expr": "(autoheal_db_pool_checked_out / autoheal_db_pool_size) * 100",
          "legendFormat": "Pool Used %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Agent mTLS Handshake Success Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "(sum(rate(autoheal_agent_mtls_handshakes_total{status=\"success\"}[5m])) / sum(rate(autoheal_agent_mtls_handshakes_total[5m]))) * 100",
          "legendFormat": "mTLS Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "API Throughput by HTTP Status Code",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(autoheal_http_requests_total[1m]))",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Request Latency Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(autoheal_http_request_duration_seconds[5m]) / rate(autoheal_http_requests_total[5m])",
          "legendFormat": "Average Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 7,
      "title": "Autonomous Recovery Execution Outcomes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status, mode) (rate(autoheal_recovery_executions_total[5m]))",
          "legendFormat": "{{mode}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 8,
      "title": "Security Audit Events by Severity",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (severity) (rate(autoheal_security_audit_events_total[5m]))",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ]
    }
  ],
