# ==============================================================================
# AutoHeal DevOps — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
# cp .env.example .env
# ==============================================================================

# Application & Environment
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=autoheal_insecure_dev_secret_change_in_production_1234567890

# Frontend Next.js API Base URL (used by browser & SWR)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Connection (AsyncIO driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://autoheal_user:autoheal_dev_password@localhost:5432/autoheal_db

# Redis Broker & Cache (for Celery and session revocation)
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Multi-Tenant Organization
DEFAULT_ORGANIZATION_NAME=AutoHeal Workspace
DEFAULT_ORGANIZATION_SLUG=autoheal-workspace

# AI Diagnosis Provider (gemini | anthropic | openai | none)
# Default is 'none' during initial development (triggers deterministic fallback)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-pro
AI_TIMEOUT_SECONDS=8.0

# Monitoring & Alerting
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_HMAC_SECRET=autoheal_alertmanager_webhook_hmac_secret_key_12345
METRIC_SCRAPE_INTERVAL_SECONDS=15
