# AutoHeal DevOps — Vercel Serverless Backend Environment Configuration
# Template for Vercel Project Environment Variables (Connected to Neon PostgreSQL)
#
# INSTRUCTIONS:
# Copy the values below into your Vercel Project Settings -> Environment Variables.
# Replace placeholder values (<...>) with your genuine service credentials.

# -----------------------------------------------------------------------------
# Runtime & Identity
# -----------------------------------------------------------------------------
APP_NAME="AutoHeal DevOps API"
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
VERCEL=1

# -----------------------------------------------------------------------------
# Security & Cryptography
# Generate a strong 64-char key: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=replace_with_a_cryptographically_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AlertManager webhook HMAC verification secret
ALERTMANAGER_HMAC_SECRET=replace_with_secure_alertmanager_hmac_secret_32_chars

# -----------------------------------------------------------------------------
# CORS Allowed Origins
# Must include your deployed Vercel frontend domain
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://autoheal-omega.vercel.app,https://autoheal-devops.vercel.app,http://localhost:3000

# -----------------------------------------------------------------------------
# Database — Neon PostgreSQL Free (Pooled Connection)
# IMPORTANT: Use the pooled connection string (-pooler in host) with asyncpg driver:
# Example: postgresql+asyncpg://neondb_owner:npg_xxxx@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<neon-host>-pooler.<region>.aws.neon.tech/<database_name>?ssl=require
DB_POOL_CLASS=NullPool
DB_SSL_MODE=require

# -----------------------------------------------------------------------------
# Rate Limiting & Incident Management
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
INCIDENT_RESOLUTION_TIMEOUT_SECONDS=300
INCIDENT_MAX_CONCURRENT=10

# -----------------------------------------------------------------------------
# Safety & Containment Policies (CRITICAL: MUST REMAIN UNMODIFIED)
# -----------------------------------------------------------------------------
RECOVERY_SIMULATION_MODE=true
RESTRICTED_DOCKER_AGENT_ENABLED=false
DOCKER_SOCKET_PATH=""
ALLOW_DOCKER_SOCKET_FALLBACK=false
EXECUTION_WORKSPACE=/tmp/autoheal_workspace
AUDIT_LOG_ENABLED=true
