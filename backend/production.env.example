# ==============================================================================
# AutoHeal DevOps — Production Server Environment Template
# ==============================================================================
# NOTICE: NEVER commit real production credentials to version control.
# Supply these variables via your cloud host's secure environment settings
# (Render Dashboard, AWS Secrets Manager / Parameter Store, or Fly Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & Server Runtime
# ------------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Cryptographically strong secret key for JWT signing & session hashing (minimum 64 chars)
# Generate with: openssl rand -base64 48
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_BASE64_SECRET

# ------------------------------------------------------------------------------
# 2. Cross-Origin Resource Sharing (CORS) & Browser Cookies
# ------------------------------------------------------------------------------
# Explicitly allow the production Vercel frontend URL
CORS_ORIGINS=["https://autoheal-omega.vercel.app","https://autoheal-devops.vercel.app"]

# Cross-site cookie flags (HTTPS required)
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database Connection (AsyncIO / asyncpg)
# ------------------------------------------------------------------------------
# Connection string using asyncpg driver:
DATABASE_URL=postgresql+asyncpg://autoheal_user:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_DB_HOST:5432/autoheal_db

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# SSL / TLS Database Encryption (require | verify-ca | verify-full)
DB_SSL_MODE=require
DB_SSL_CA_CERT=

# ------------------------------------------------------------------------------
# 4. Redis Broker & Result Backend (Distributed Tasks & Token Revocation)
# ------------------------------------------------------------------------------
# Use rediss:// scheme for managed cloud Redis with in-transit TLS encryption
REDIS_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0
CELERY_BROKER_URL=rediss://default:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0
CELERY_RESULT_BACKEND=rediss://default:REPLACE_WITH_REDIS_PASSWORD@REPLACE_WITH_REDIS_HOST:6379/0

# Redis TLS Security
REDIS_SSL_CERT_REQS=required
REDIS_SSL_CHECK_HOSTNAME=true

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Token Lifecycle
# ------------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Tenant Organization
DEFAULT_ORGANIZATION_NAME=AutoHeal Enterprise
DEFAULT_ORGANIZATION_SLUG=autoheal-enterprise

# Rate Limiting
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Observability & Alertmanager Webhook
# ------------------------------------------------------------------------------
# Webhook authentication HMAC secret (shared with Alertmanager)
# Generate with: openssl rand -hex 32
ALERTMANAGER_HMAC_SECRET=REPLACE_WITH_32_CHAR_HEX_SECRET

PROMETHEUS_URL=http://prometheus:9090
METRIC_SCRAPE_INTERVAL_SECONDS=15

# ------------------------------------------------------------------------------
# 7. AI Diagnosis Engine
# ------------------------------------------------------------------------------
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-1.5-pro
AI_TIMEOUT_SECONDS=8.0

# ------------------------------------------------------------------------------
# 8. Safe Recovery Guardrails (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# NEVER set to false without explicit out-of-band enterprise authorization.
RECOVERY_SIMULATION_MODE=true
RESTRICTED_DOCKER_AGENT_ENABLED=false
